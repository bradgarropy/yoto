        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.2",
        "memfs": "^4.56.10",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.1.13",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.2",
        "vite": "^7.1.7",
        "vite-plugin-devtools-json": "^1.0.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.0.18"
