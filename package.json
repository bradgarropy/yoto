{
    "name": "yoto",
    "version": "1.0.0",
    "description": "Sync YouTube content to Yoto",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "react-router-serve ./build/server/index.js",
