        "@yotoplay/yoto-sdk": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "isbot": "^5.1.31",
        "lucide-react": "^0.563.0",
        "motion": "^12.31.0",
        "p-limit": "^7.3.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router": "7.12.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0"
