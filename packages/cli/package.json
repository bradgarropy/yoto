{
    "name": "@yoto/cli",
    "version": "1.0.0",
    "description": "Sync YouTube playlists to Yoto",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "yoto": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node dist/index.js",
        "test": "echo 'No tests - see @yoto/core'",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "youtube",
        "playlist",
        "yoto",
        "sync",
        "yt-dlp"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@inquirer/prompts": "^8.2.0",
        "@types/node": "^25.0.10",
        "@yoto/core": "*",
        "commander": "^14.0.2",
        "fuse.js": "^7.1.0",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@bradgarropy/eslint-config": "^3.1.2",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0"
    }
}
