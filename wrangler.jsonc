{
    "name": "yoto",
    "compatibility_date": "2026-02-14",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "main": "./workers/app.ts",
    "assets": {
        "directory": "./build/client",
    },
    "observability": {
        "enabled": true,
    },
    "workflows": [
        {
            "name": "yoto-upload",
            "binding": "UPLOAD_WORKFLOW",
            "class_name": "UploadWorkflow",
        },
    ],
    "routes": [
        {
            "pattern": "yoto.bradgarropy.com",
            "custom_domain": true,
        },
    ],
    "containers": [
        {
            "class_name": "Sandbox",
            "image": "./Dockerfile.sandbox",
            "instance_type": "standard-2",
            "max_instances": 3,
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "Sandbox",
                "name": "SANDBOX",
            },
        ],
    },
    "migrations": [
        {
            "new_sqlite_classes": ["Sandbox"],
            "tag": "v1",
        },
    ],
}
